# --- BACKEND ENVIRONMENT VARIABLES ---
# PostgreSQL connection URL for Railway / Supabase
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# JWT Token Secret Key
SECRET_KEY=supersecretjwtkey_change_me_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma separated URLs or * for all)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- FRONTEND ENVIRONMENT VARIABLES ---
# Base HTTP URL pointing to deployed Railway backend
VITE_API_URL=https://your-railway-app.up.railway.app
