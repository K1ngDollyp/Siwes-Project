# Database URL: Supports PostgreSQL (postgresql+asyncpg://...) or fallback SQLite (sqlite+aiosqlite:///./chat.db)
DATABASE_URL=sqlite+aiosqlite:///./chat.db

# JWT Configuration
SECRET_KEY=supersecretjwtkey_change_me_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS settings
CORS_ORIGINS=*
